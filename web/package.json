{
  "name": "torrserver_web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@internationalized/date": "^3.12.4",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@tanstack/react-query": "^5.104.5",
    "axios": "^1.20.0",
    "gsap": "^3.15.0",
    "hls.js": "1.7.3",
    "i18next": "^26.5.10",
    "i18next-browser-languagedetector": "^8.2.2",
    "lucide-react": "^1.61.0",
    "media-chrome": "^4.19.4",
    "parse-torrent": "^11.0.24",
    "parse-torrent-title": "^3.0.1",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-i18next": "^17.1.8",
    "sonner": "^2.0.8"
  },
  "scripts": {
    "i18n:check": "node scripts/i18n-check.mjs",
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node --test --test-reporter=spec e2e/settings.mock.test.mjs",
    "test:e2e:live": "node --test --test-reporter=spec e2e/live-torrent.test.mjs",
    "verify": "yarn typecheck && yarn lint && yarn test && yarn i18n:check && yarn test:e2e",
    "preview": "vite preview",
    "lint": "eslint src --color",
    "fix": "eslint src --fix --color",
    "screenshots:iphone": "node scripts/screenshots-iphone.mjs",
    "screenshots:viewports": "node scripts/screenshots-viewports.mjs"
  },
  "browserslist": {
    "production": [
      "chrome >= 117",
      "firefox >= 121",
      "safari >= 17",
      "edge >= 121",
      "not dead"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/parse-torrent": "^11.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "description": "TorrServer web client",
  "license": "GPL-3.0"
}
