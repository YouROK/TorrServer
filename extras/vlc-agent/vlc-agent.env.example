# Listen on 127.0.0.1 for a local reverse proxy, or 0.0.0.0 for direct LAN access.
VLC_AGENT_HOST=127.0.0.1
VLC_AGENT_PORT=8092

# Required when listening outside loopback. The installer generates this value.
VLC_AGENT_TOKEN=

# Optional comma-separated TorrServer hostnames or IP addresses accepted in stream_url.
# Example: 192.168.1.10,movies.example.net
VLC_AGENT_ALLOWED_HOSTS=

VLC_AGENT_PLAYER=/usr/bin/vlc
VLC_AGENT_PLAYER_ARGS="--no-one-instance --no-video-title-show --network-caching=3000 --http-reconnect"
VLC_AGENT_STOP_TIMEOUT=3
